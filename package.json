{
  "name": "wordrosco",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @wordrosco/db migrate",
    "db:seed": "pnpm --filter @wordrosco/db seed",
    "db:studio": "pnpm --filter @wordrosco/db studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "packageManager": "pnpm@11.0.8"
}